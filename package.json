{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"pnpm run dev:api\" \"pnpm run dev:portfolio\"",
    "dev:api": "dotenv -e .env -- pnpm --filter @workspace/api-server run start",
    "dev:portfolio": "dotenv -e .env -- cross-env PORT=5173 pnpm --filter @workspace/portfolio run dev",
    "start": "pnpm run start:api",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "build:portfolio": "pnpm --filter @workspace/portfolio build",
    "start:api": "pnpm --filter @workspace/api-server start",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.60.4",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "lightningcss": "^1.32.0",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
